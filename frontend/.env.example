# ──────────────────────────────────────────────
#  OSRM Frontend Server 環境設定檔 (範例)
#  複製此檔案為 .env 後再修改:
#    cp .env.example .env
# ──────────────────────────────────────────────

# 伺服器監聽位址 (0.0.0.0 表示所有網路介面)
HOST=0.0.0.0

# 伺服器監聽埠號
PORT=3000

# Node.js 執行環境 (development / production)
NODE_ENV=development
